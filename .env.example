# This project does not copy credentials from any other project.
PRAGENT_REVIEW_HOST=127.0.0.1
PRAGENT_REVIEW_PORT=8082
PRAGENT_REVIEW_DB_PATH=prompt_review.db

# GitHub fine-grained PAT: repository metadata + pull requests read;
# add issues write only if automatic PR comments are enabled.
PRAGENT_REVIEW_GITHUB_TOKEN=
PRAGENT_REVIEW_GITHUB_WEBHOOK_SECRET=
PRAGENT_REVIEW_AUTO_POST_REVIEW=false
# The public HTTPS base URL used when creating a GitHub Webhook.
PRAGENT_REVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8082

# Any OpenAI-compatible Chat Completions endpoint, including the configured MiMo endpoint.
PRAGENT_REVIEW_LLM_BASE_URL=
PRAGENT_REVIEW_LLM_API_KEY=
PRAGENT_REVIEW_LLM_MODEL=
PRAGENT_REVIEW_TIMEOUT_SECONDS=90